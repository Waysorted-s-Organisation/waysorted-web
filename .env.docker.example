# Local Docker runtime. Copy this file to .env.docker.local and keep it uncommitted.
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEV_PRICING_COUNTRY=IN

# Docker Compose overrides both Mongo values to the local `mongo` service.
MONGODB_URI=mongodb://mongo:27017/waysorted_local
MONGODB_URI_TOOLS=mongodb://mongo:27017/waysorted_local

# Create localhost OAuth credentials or copy only these two values from a
# development credential set. Add the callback below in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Use Razorpay TEST mode credentials only. Never put live keys here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=local-webhook-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Local-only signing values. Replace them if another local service must sign
# callbacks against this container.
BILLING_BRIDGE_SECRET=local-dev-billing-bridge-secret
PROCESSOR_CALLBACK_SECRET=local-dev-processor-callback-secret
STARTER_GRANT_SECRET=local-dev-starter-grant-secret
SESSION_SECRET=local-dev-session-secret
JWT_SECRET=local-dev-jwt-secret
CRON_SECRET=local-dev-cron-secret

# External effects stay disabled for local development.
NOTIFICATION_PRODUCER_ENABLED=false
NOTIFICATION_N4_PRODUCER_ENABLED=false
NOTIFICATION_N4_CANARY_TEST_ENABLED=false
NOTIFICATION_INGEST_URL=
NOTIFICATION_INGEST_TOKEN=
NOTIFICATION_EVENT_SOURCE=waysorted-web-local

# Optional services. Leave blank until the matching feature is being tested.
EMAIL_USER=
EMAIL_PASS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AI_BACKEND_URL=
AI_PLUGIN_TOKEN=

# Browser/API origins for the local app only.
ALLOWED_API_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cloudflare cache purge. Without these, publishing changes Mongo but not what
# visitors are served - purgeUrls() logs a skip and does nothing. Token needs only
# Zone > Cache Purge on waysorted.com.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PURGE_TOKEN=
